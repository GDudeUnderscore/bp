{
    "model": {
        "type": "select",
        "property": "custom_model_data",
        "fallback": {
            "type": "model",
            "model": "item/golden_sword"
        },
        "cases": [
            {"when": "hellfire", "model": {"type": "model", "model": "item/swords/hellfire"}},
            {"when": "swift_katana", "model": {"type": "model", "model": "item/swords/swift_katana"}}
        ]
    }
}