{
    "model": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",

        "on_false": {
            "type": "select", "property": "custom_model_data",
            "fallback": { "type": "model", "model": "item/bow" },
            "cases": [
                { "when": "flimsy_bow",     "model": { "type": "model", "model": "item/bows/flimsy_bow/flimsy_bow" }},
                { "when": "reinforced_bow", "model": { "type": "model", "model": "item/bows/reinforced_bow/reinforced_bow" }},
                { "when": "keen_eye",       "model": { "type": "model", "model": "item/bows/keen_eye/keen_eye" }},
                { "when": "double_shooter", "model": { "type": "model", "model": "item/bows/double_shooter/double_shooter" }}
            ]
        },

        "on_true": {
            "type": "minecraft:range_dispatch",
            
            "fallback": { 
                "type": "select", "property": "custom_model_data", 
                "fallback": { "type": "model", "model": "item/bow_pulling_0"},
                "cases": [
                    { "when": "flimsy_bow",     "model": { "type": "model", "model": "item/bows/flimsy_bow/flimsy_bow_pulling_0" }},
                    { "when": "reinforced_bow", "model": { "type": "model", "model": "item/bows/reinforced_bow/reinforced_bow_pulling_0" }},
                    { "when": "keen_eye",       "model": { "type": "model", "model": "item/bows/keen_eye/keen_eye_pulling_0" }},
                    { "when": "double_shooter", "model": { "type": "model", "model": "item/bows/double_shooter/double_shooter_pulling_0" }}
                ]
            },

            "entries": [
                { "model": { 
                    "type": "select", "property": "custom_model_data", 
                    "fallback": { "type": "model", "model": "item/bow_pulling_1" }, 
                    "cases": [
                        { "when": "flimsy_bow",     "model": { "type": "model", "model": "item/bows/flimsy_bow/flimsy_bow_pulling_1" }},
                        { "when": "reinforced_bow", "model": { "type": "model", "model": "item/bows/reinforced_bow/reinforced_bow_pulling_1" }},
                        { "when": "keen_eye",       "model": { "type": "model", "model": "item/bows/keen_eye/keen_eye_pulling_1" }},
                        { "when": "double_shooter", "model": { "type": "model", "model": "item/bows/double_shooter/double_shooter_pulling_1" }}
                    ]}, "threshold": 0.65 
                },

                { "model": { 
                    "type": "select", "property": "custom_model_data", 
                    "fallback": { "type": "model", "model": "item/bow_pulling_2"}, 
                    "cases": [
                        { "when": "flimsy_bow",     "model": { "type": "model", "model": "item/bows/flimsy_bow/flimsy_bow_pulling_2" }},
                        { "when": "reinforced_bow", "model": { "type": "model", "model": "item/bows/reinforced_bow/reinforced_bow_pulling_2" }},
                        { "when": "keen_eye",       "model": { "type": "model", "model": "item/bows/keen_eye/keen_eye_pulling_2" }},
                        { "when": "double_shooter", "model": { "type": "model", "model": "item/bows/double_shooter/double_shooter_pulling_2" }}
                    ]}, "threshold": 0.90 
                }
            ],

            "property": "minecraft:use_duration",
            "scale": 0.05
        }
    }
}